<%- include('../partials/header', { title: 'Admin Login' }) %>
<div class="auth-page admin-auth">
  <div class="auth-card">
    <div class="auth-icon">🛡️</div>
    <span class="eyebrow">ADMIN PORTAL</span>
    <h1>Administrator Login</h1>
    <p class="muted">Manage books and registered clients.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <label>Admin Email</label>
      <input type="email" name="email" required>
      <label>Password</label>
      <input type="password" name="password" required>
      <button class="btn primary full" type="submit">Enter Dashboard</button>
    </form>
    <p class="form-foot"><a href="/">← Back to store</a></p>
  </div>
</div>
<%- include('../partials/footer') %>