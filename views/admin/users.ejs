<%- include('../partials/header', { title: 'Clients' }) %>
<section class="admin-section">
  <div class="section-heading"><div><span class="eyebrow">ADMIN</span><h1>Registered Clients</h1></div></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Registered</th></tr></thead>
      <tbody>
      <% users.forEach(u => { %>
        <tr><td><strong><%= u.name %></strong></td><td><%= u.email %></td><td><span class="role"><%= u.role %></span></td><td><%= new Date(u.created_at).toLocaleDateString() %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>