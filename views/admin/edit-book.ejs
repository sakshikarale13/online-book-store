<%- include('../partials/header', { title: 'Edit Book' }) %>
<div class="form-page">
  <div class="form-card">
    <span class="eyebrow">ADMIN</span><h1>Edit Book</h1>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/admin/books/edit/<%= book.id %>">
      <label>Book Title</label><input name="title" value="<%= book.title %>" required>
      <label>Author</label><input name="author" value="<%= book.author %>" required>
      <label>Price (₹)</label><input type="number" name="price" value="<%= book.price %>" min="0" step="0.01" required>
      <label>Image URL</label><input name="image" value="<%= book.image %>">
      <label>Description</label><textarea name="description" rows="5"><%= book.description %></textarea>
      <div class="form-actions"><a href="/admin/books" class="btn secondary">Cancel</a><button class="btn primary" type="submit">Save Changes</button></div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>