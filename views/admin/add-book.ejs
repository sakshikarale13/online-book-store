<%- include('../partials/header', { title: 'Add Book' }) %>
<div class="form-page">
  <div class="form-card">
    <span class="eyebrow">ADMIN</span><h1>Add New Book</h1>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/admin/books/add">
      <label>Book Title</label><input name="title" required>
      <label>Author</label><input name="author" required>
      <label>Price (₹)</label><input type="number" name="price" min="0" step="0.01" required>
      <label>Image URL</label><input name="image" placeholder="https://...">
      <label>Description</label><textarea name="description" rows="5"></textarea>
      <div class="form-actions"><a href="/admin/books" class="btn secondary">Cancel</a><button class="btn primary" type="submit">Add Book</button></div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>