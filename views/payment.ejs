<%- include('partials/header', { title: 'Payment' }) %>
<section class="page-banner"><span class="eyebrow">SECURE CHECKOUT DEMO</span><h1>Choose Payment Method</h1><p>This is a simulated payment. No real money is charged.</p></section>
<section class="checkout-page">
  <div class="payment-card">
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/payment" id="paymentForm">
      <div class="method-grid">
        <label class="method-option"><input type="radio" name="method" value="UPI" checked onchange="showMethod('upi')"><span>📱</span><strong>UPI</strong><small>Demo payment</small></label>
        <label class="method-option"><input type="radio" name="method" value="Card" onchange="showMethod('card')"><span>💳</span><strong>Card</strong><small>Demo payment</small></label>
        <label class="method-option"><input type="radio" name="method" value="Cash on Delivery" onchange="showMethod('cod')"><span>📦</span><strong>Cash on Delivery</strong><small>Pay on delivery</small></label>
      </div>
      <div id="upi" class="method-fields"><label>UPI ID</label><input name="upi_id" placeholder="name@upi"></div>
      <div id="card" class="method-fields hidden"><label>Card Number</label><input name="card_number" inputmode="numeric" maxlength="19" placeholder="1234 5678 9012 3456"><label>Card Holder Name</label><input name="card_name"><div class="two-col"><div><label>Expiry</label><input name="expiry" placeholder="MM/YY" maxlength="5"></div><div><label>CVV</label><input name="cvv" maxlength="4" type="password"></div></div></div>
      <div id="cod" class="method-fields hidden"><div class="cod-note">📦 Your order will be confirmed and payment will be collected at delivery.</div></div>
      <button class="btn primary full" type="submit">Pay ₹<%= total.toFixed(2) %> (Demo)</button>
    </form>
    <p class="demo-note">🔒 Demo only: payment details are not stored. Card/CVV are never saved in the database.</p>
  </div>
  <aside class="summary-card"><span class="eyebrow">PAYMENT</span><h2>Amount Due</h2><div class="summary-row total"><span>Total</span><strong>₹<%= total.toFixed(2) %></strong></div></aside>
</section>
<script>
function showMethod(type){
  ['upi','card','cod'].forEach(id=>document.getElementById(id).classList.toggle('hidden',id!==type));
}
</script>
<%- include('partials/footer') %>