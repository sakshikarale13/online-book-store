<%- include('partials/header', { title: 'Register' }) %>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon">✨</div>
    <span class="eyebrow">JOIN BOOKNEST</span>
    <h1>Create your account</h1>
    <p class="muted">Register to access our online catalogue.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/register">
      <label>Full Name</label>
      <input type="text" name="name" placeholder="Your name" required>
      <label>Email</label>
      <input type="email" name="email" placeholder="you@example.com" required>
      <label>Password</label>
      <input type="password" name="password" minlength="6" placeholder="Minimum 6 characters" required>
      <button class="btn primary full" type="submit">Create Account</button>
    </form>
    <p class="form-foot">Already registered? <a href="/login">Login here</a></p>
  </div>
</div>
<%- include('partials/footer') %>